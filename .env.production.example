# Checkmate Production Environment Variables
# Copy this file to .env.production and update with your values

# === REQUIRED CONFIGURATION (MUST CHANGE!) ===

# Application URLs - Update with your domain
CLIENT_HOST=http://localhost
CLIENT_API_URL=http://localhost/api/v1

# Security - CRITICAL: Use strong, unique values in production!
JWT_SECRET=CHANGE-THIS-use-random-string-min-32-chars
TOKEN_TTL=24h  # Session duration: 1h, 24h, 7d, etc.

# MongoDB Credentials - CRITICAL: Use strong passwords!
MONGO_ROOT_USER=checkmate_admin
MONGO_ROOT_PASSWORD=CHANGE-THIS-strong-mongodb-password
MONGO_APP_PASSWORD=CHANGE-THIS-strong-app-password

# Server Port (Usually no need to change)
PORT=52345

# === OPTIONAL CONFIGURATION ===

# Email Notifications (Leave empty to disable)
SYSTEM_EMAIL_HOST=smtp.gmail.com
SYSTEM_EMAIL_PORT=587
SYSTEM_EMAIL_USER=
SYSTEM_EMAIL_PASSWORD=
SYSTEM_EMAIL_FROM=noreply@localhost

# Logging
LOG_LEVEL=info  # Options: debug, info, warn, error

# Capture Agent for infrastructure monitoring
CAPTURE_API_SECRET=your-capture-secret-key

# SSL/TLS Configuration (For HTTPS)
USE_SSL=false
SSL_CERT_PATH=
SSL_KEY_PATH=