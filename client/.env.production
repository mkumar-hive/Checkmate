# Checkmate Production Environment Variables
# Configured for local deployment

# === CLIENT CONFIGURATION ===
# The public URL where your Checkmate instance will be accessible
CLIENT_HOST=http://localhost
CLIENT_API_URL=http://localhost/api/v1

# === SERVER CONFIGURATION ===
# JWT Configuration
JWT_SECRET=checkmate-local-production-secret-key-do-not-use-in-real-production
TOKEN_TTL=86400

# Server port
PORT=52345

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# === DATABASE CONFIGURATION ===
# MongoDB connection
DB_CONNECTION_STRING=mongodb://checkmate_app:checkmate_app_password_2024@mongodb:27017/checkmate?authSource=checkmate
MONGO_ROOT_USER=checkmate_admin
MONGO_ROOT_PASSWORD=checkmate_secure_password_2024
MONGO_APP_PASSWORD=checkmate_app_password_2024

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379

# === EMAIL CONFIGURATION (Optional) ===
# Leave empty for local testing
SYSTEM_EMAIL_HOST=
SYSTEM_EMAIL_PORT=
SYSTEM_EMAIL_USER=
SYSTEM_EMAIL_PASSWORD=
SYSTEM_EMAIL_FROM=noreply@localhost

# === CAPTURE AGENT (Optional) ===
# For infrastructure monitoring
CAPTURE_API_SECRET=local-capture-secret-key

# === SSL CONFIGURATION ===
# Set to true if using HTTPS
USE_SSL=false
SSL_CERT_PATH=
SSL_KEY_PATH=
